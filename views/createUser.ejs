<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
</head>

<body>
  <h1>
    <%= title %>
  </h1>
  <%- include('partials/errors') %>
    <form action="/create" method="post" style="display: flex; flex-direction: column; align-items: center; gap:1em;">
      <div style="width: 300px; display:flex; justify-content:space-between">
        <label for="firstName">* First Name: </label>
        <input type="text" name="firstName" id="firstName" required>
      </div>
      <div style="width: 300px; display:flex; justify-content:space-between">
        <label for="lastName">* Last Name: </label>
        <input type="text" name="lastName" id="lastName" required>
      </div>
      <div style="width: 300px; display:flex; justify-content:space-between">
        <label for="email">* Email: </label>
        <input type="text" name="email" id="email" required>
      </div>
      <div style="width: 300px; display:flex; justify-content:space-between">
        <label for="age">Age: (optional)</label>
        <input type="number" name="age" id="age">
      </div>
      <div style="width: 320px; display:flex; justify-content:space-between">
        <label for="bio">Bio: (optional)</label>
        <textarea name="bio" id="bio" rows="5" cols="25"></textarea>
      </div>
      <button type="submit">Submit</button>
    </form>
    <a href="/">Back to home</a>
</body>

</html>